{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guestbook",
  "compatibility_date": "2026-08-31",
  "main": "./worker/frontend.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/guestbook/*"
    ]
  }
}